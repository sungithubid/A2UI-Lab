# Monoseed 配置清单。复制为 .env 后，Go CLI 会自动读取当前目录中的 .env。
# 优先级：进程环境变量 > .env > 内置默认值；空值选择内置默认值。
# 不需要 source，也不会执行 shell 命令。路径请写完整的绝对路径，勿使用 ~、$HOME。
# 如需从任意目录启动：在进程环境设置 APP_ENV_FILE=/absolute/path/.env。
# APP_ENV_FILE=- 可关闭文件加载；此选项只从进程环境读取。
# 不自动加载 .env.local / .env.production 等额外文件。

# --- 运行环境与监听 ---
# development | test | production；production 强制 HTTPS Origin + Secure Cookie。
APP_ENV=development
APP_ADDR=127.0.0.1:8080
# 浏览器访问的精确 Origin，不带尾部 /。make dev 使用 http://localhost:5173，也接受同端口 http://127.0.0.1:5173。
APP_ORIGIN=http://localhost:8080
# 留空时：Go 使用系统用户配置目录/monoseed；make dev 使用项目内绝对路径 .data。
# 生产示例：APP_DATA_DIR=/var/lib/monoseed
APP_DATA_DIR=

# --- 开发模式可选管理员（默认不创建账号）---
# 同时设置邮箱和密码后，serve/make dev 首次启动自动创建 owner 和 Workspace。
# 仅 APP_ENV=development 可用；production/test 禁止设置账号或密码。
# 已有同邮箱用户不会被覆盖，修改此处密码不会重置已有密码。
# 密码 12–72 字节；config show 会脱敏，密码不写入日志。
APP_DEV_ADMIN_EMAIL=
APP_DEV_ADMIN_PASSWORD=
APP_DEV_ADMIN_WORKSPACE=Development

# --- 日志 ---
# debug | info | warn | error
APP_LOG_LEVEL=info
# json（适合日志采集）| text（适合本地阅读）
APP_LOG_FORMAT=json

# --- 会话与 Cookie ---
# HTTPS 必须设置 true；make dev 本地 HTTP 固定为 false。
APP_COOKIE_SECURE=false
# Go duration 语法：500ms、15s、2m、168h；不支持 7d。至少 1s。
APP_SESSION_TTL=168h

# --- HTTP Server 超时（必须 > 0，不能用 0 关闭保护）---
# 读取请求头的最大时间。
APP_HTTP_READ_HEADER_TIMEOUT=5s
# 读取整个请求（含请求体）的最大时间，不能小于 READ_HEADER_TIMEOUT。
APP_HTTP_READ_TIMEOUT=15s
# 请求处理的总体截止时间；超时返回 503。
APP_HTTP_REQUEST_TIMEOUT=30s
# 写响应的最大时间，必须大于 REQUEST_TIMEOUT，给超时响应留出时间。
APP_HTTP_WRITE_TIMEOUT=35s
# Keep-Alive 连接等待下一次请求的时间。
APP_HTTP_IDLE_TIMEOUT=60s
# 收到 SIGINT/SIGTERM 后等待正在处理的请求结束的时间。
APP_HTTP_SHUTDOWN_TIMEOUT=10s
# /readyz 数据库检查截止时间，不能大于 REQUEST_TIMEOUT。
APP_HTTP_HEALTH_TIMEOUT=2s

# --- HTTP 大小限制（十进制字节数，不接受 1MB 等单位）---
# 请求头上限：默认 1 MiB，允许 1..16777216。
APP_HTTP_MAX_HEADER_BYTES=1048576
# 全局请求体上限：默认 128 KiB，允许 1..67108864。
# 各 API 保留更小的业务上限（登录/创建 Workspace 4 KiB、Notes 128 KiB）；取较小者。
APP_HTTP_MAX_BODY_BYTES=131072

# 生产部署示例（启用前取消注释，并替换实际地址和路径）：
# APP_ENV=production
# APP_ORIGIN=https://app.example.com
# APP_COOKIE_SECURE=true
# APP_DATA_DIR=/var/lib/monoseed
